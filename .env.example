# ==============================================================
# FastAPI E-Commerce API — Environment Configuration
# ==============================================================

# ─── API Settings ─────────────────────────────────────────────
PROJECT_NAME="FastAPI E-Commerce API"
API_V1_STR="/api/v1"
SECRET_KEY="your-super-secret-key-change-this-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEBUG=True

# ─── CORS ─────────────────────────────────────────────────────
# Comma-separated list of origins
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:8080,http://localhost:3000"

# ─── PostgreSQL Database ──────────────────────────────────────
# Sync URL for Alembic
SQLALCHEMY_DATABASE_URI="postgresql://postgres:postgres@localhost:5432/fastapi_ecommerce"
# Async URL for FastAPI
POSTGRES_ASYNC_URI="postgresql+asyncpg://postgres:postgres@localhost:5432/fastapi_ecommerce"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fastapi_ecommerce

# ─── Redis Caching ────────────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"

# ─── Stripe Payments ──────────────────────────────────────────
STRIPE_API_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CURRENCY="usd"

# ─── First Superuser ──────────────────────────────────────────
FIRST_SUPERUSER="admin@example.com"
FIRST_SUPERUSER_PASSWORD="SecureAdminPassword123!"
